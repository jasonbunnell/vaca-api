# Copy to config/.env and fill in values
# JWT_SECRET=your-secret
# MONGODB_URI=mongodb://localhost:27017/vaca-api

# CORS allowed origins (comma-separated). Default includes localhost and flxvacations.com
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://flxvacations.com

# Google Geocoding (server-side; node-geocoder — see docs/google-maps-geocoding-setup.md)
# GEOCODER_PROVIDER=google
# GEOCODER_API_KEY=your-server-geocoding-key

# Digital Ocean Spaces (property image uploads)
# Get keys from DO Control Panel > API > Spaces Keys
# SPACES_BUCKET_NAME=flxvaca
# SPACES_REGION=nyc3
# SPACES_ACCESS_KEY_ID=your-access-key
# SPACES_SECRET_ACCESS_KEY=your-secret-key

# Public site origin (used for sitemap URLs and Stripe Checkout return URLs)
# PUBLIC_SITE_URL=https://flxvacations.com

# Stripe (test mode keys start with sk_test_/pk_test_; live with sk_live_/pk_live_)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx
#
# Stripe Price IDs — one per (plan, billingType, launch|standard) slot.
# Launch IDs are sufficient during launch period; standard IDs only needed
# after the launch promo ends.
# STRIPE_PRICE_BOOST_ANNUAL_LAUNCH=price_xxxx
# STRIPE_PRICE_BOOST_ANNUAL_STANDARD=price_xxxx
# STRIPE_PRICE_PRO_ANNUAL_LAUNCH=price_xxxx
# STRIPE_PRICE_PRO_ANNUAL_STANDARD=price_xxxx
# STRIPE_PRICE_PRO_LIFETIME_LAUNCH=price_xxxx

#

# --- Email (CRM-1): Brevo SMTP in prod, Mailtrap sandbox ok in dev, blank = sends skipped ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL=noreply@flxvacations.com
FROM_NAME=FLX Vacations
REPLY_TO=
CONTACT_TO=jason@flxcompass.com
PUBLIC_SITE_URL=https://flxvacations.com
